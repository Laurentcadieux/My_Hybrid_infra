server {
    listen 80;
    server_name {{ site_domain }} www.{{ site_domain }};
    root /var/www/{{ site_domain }}/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
